# Copy to .env — every key is optional; Airlock runs fully offline without any of them.

# Daytona — experiments run in a pool of real sandboxes instead of local processes.
DAYTONA_API_KEY=
# AIRLOCK_DAYTONA_POOL=4
# AIRLOCK_RUNNER=local        # force the local pool even when a key is present

# Nosana — an open model (Qwen / Llama …) deployed on Nosana's GPU network exposes an
# OpenAI-compatible /v1 URL. Airlock uses it to answer `why` questions from the ledger
# and to write the closing insight. It never produces a score — fitness is measured.
AIRLOCK_LLM_BASE=            # e.g. https://<deployment>.node.k8s.prd.nos.ci/v1
AIRLOCK_LLM_KEY=             # leave empty if the deployment is open
AIRLOCK_LLM_MODEL=           # empty → first model the endpoint lists
# AIRLOCK_LLM_PROVIDER=Nosana

# DNSimple — publish a finished lab's report to a subdomain.
DNSIMPLE_TOKEN=
DNSIMPLE_ACCOUNT=
DNSIMPLE_DOMAIN=

# AIRLOCK_PORT=8770
